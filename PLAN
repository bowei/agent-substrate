### 5.3. Structure of `hack/install-ate.sh` Bridge
```bash
#!/usr/bin/env bash
set -o errexit -o nounset -o pipefail

ROOT="$(git rev-parse --show-toplevel)"
cd "${ROOT}"

# Locate or build ate-setup binary
ATESETUP="go run ./cmd/ate-setup"
if [[ -x "bin/ate-setup" ]]; then
  ATESETUP="bin/ate-setup"
fi

# 1. Handle --help / -h
# 2. Parse global modifier flags and build GLOBAL_FLAGS array
# 3. Parse action flags into ACTIONS array
# 4. Loop over ACTIONS, executing:
#    $ATESETUP "${GLOBAL_FLAGS[@]}" "${ACTION_COMMAND[@]}"
```

### 5.4. Structure of `hack/install-ate-kind.sh` Bridge
```bash
#!/usr/bin/env bash
set -o errexit -o nounset -o pipefail

ROOT="$(git rev-parse --show-toplevel)"
cd "${ROOT}"

goarch=$(go env GOARCH)
export NO_DEV_ENV="true"
export KO_DOCKER_REPO="${KO_DOCKER_REPO:-localhost:5001}"
export KO_DEFAULTPLATFORMS="linux/${goarch}"
export ATE_INSTALL_KIND="true"
export BUCKET_NAME="ate-snapshots"
KIND_CLUSTER_NAME="${KIND_CLUSTER_NAME:-kind}"
export KUBECTL_CONTEXT="${KUBECTL_CONTEXT:-kind-${KIND_CLUSTER_NAME}}"
unset GCE_REGION CLUSTER_LOCATION NETWORK SUBNETWORK MEMORYSTORE_INSTANCE PROJECT_ID

exec hack/install-ate.sh "$@"
```

